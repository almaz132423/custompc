DATABASE_URL="postgresql://customps:customps_dev_password@localhost:5432/customps?schema=public"
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Email notifications via Resend
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
NOTIFICATION_EMAIL_FROM="CustomPS <notifications@example.com>"
# Multiple recipients are supported as a comma-separated list.
NOTIFICATION_EMAIL_TO="manager@example.com"
